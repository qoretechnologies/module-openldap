#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires openldap
%requires LdapCli
%requires Util
%requires qore >= 2.3

main();

const PasswdOpts = CommonOpts + {
    "oldpwd": "a,old=s",
    "promptold": "A,prompt-old",
    "newpwd": "s,new=s",
    "promptnew": "S,prompt-new",
};

sub main() {
    GetOpt g(PasswdOpts);
    hash opts = g.parse3(\ARGV);

    Util::TerminalColor color(!opts.nocolor);

    if (opts.help) {
        usage(color);
    }

    handle_common_opts(opts, color);

    *string dn = shift ARGV;
    if (!dn) {
        ldap_error(color, "missing dn of user to change password for");
    }

    process_bind_password(\opts);

    if (opts.promptold) {
        stdout.printf("Enter Old Password: ");
        TerminalInputHelper t();
        opts.oldpwd = t.getLine();
    }

    if (opts.promptnew) {
        stdout.printf("Enter New Password: ");
        TerminalInputHelper t();
        string p1 = t.getLine();
        stdout.printf("Re-enter New Password: ");
        string p2 = t.getLine();
        if (p1 != p2) {
            ldap_error(color, "new passwords do not match");
        }
        opts.newpwd = p1;
    }

    if (!opts.oldpwd) {
        ldap_error(color, "missing old password (use -a or -A)");
    }
    if (!opts.newpwd) {
        ldap_error(color, "missing new password (use -s or -S)");
    }

    string uri = get_uri(opts);
    hash lopt = opts{LdapOptionKeys};

    if (opts.verbose) {
        printf("%s %s\n", color.dim("uri:"), uri);
        printf("%s %s\n", color.dim("dn:"), dn);
    }

    try {
        LdapClient ldap(uri, lopt);
        ldap.passwd(dn, opts.oldpwd, opts.newpwd);
        ldap_success(color, sprintf("password changed for: %s", dn));
    } catch (hash<ExceptionInfo> ex) {
        ldap_error(color, "%s: %s", ex.err, ex.desc);
    }
}

sub usage(Util::TerminalColor color) {
    printf("%s %s [options] <dn>\n\n", color.bold("usage:"), get_script_name());
    printf("%s\n", color.bold("Password Change Options:"));
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-a,--old=ARG", 22)), "old password");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-A,--prompt-old", 22)), "prompt for old password");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-s,--new=ARG", 22)), "new password");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-S,--prompt-new", 22)), "prompt for new password");
    printf("\n");
    print_common_usage(color);
    exit(0);
}
