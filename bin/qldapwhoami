#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires openldap
%requires Util
%requires qore >= 2.3

%include qldaplib.ql

main();

sub main() {
    GetOpt g(CommonOpts);
    hash opts = g.parse3(\ARGV);

    Util::TerminalColor color(!opts.nocolor);

    if (opts.help) {
        usage(color);
    }

    handle_common_opts(opts, color);
    process_bind_password(\opts);
    string uri = get_uri(opts);
    hash lopt = opts{LdapOptionKeys};

    if (opts.verbose) {
        printf("%s %s\n", color.dim("uri:"), uri);
    }

    try {
        LdapClient ldap(uri, lopt);
        hash<auto> result = ldap.extendedOp(LDAP_EXOP_WHO_AM_I);
        if (exists result.value) {
            printf("%s\n", result.value.toString("UTF-8"));
        } else {
            printf("%s\n", color.dim("anonymous"));
        }
    } catch (hash<ExceptionInfo> ex) {
        ldap_error(color, "%s: %s", ex.err, ex.desc);
    }
}

sub usage(Util::TerminalColor color) {
    printf("%s %s [options]\n\n", color.bold("usage:"), get_script_name());
    printf("Performs a Who Am I? extended operation (RFC 4532) and prints the\n");
    printf("authorization identity of the current connection.\n\n");
    print_common_usage(color);
    exit(0);
}
