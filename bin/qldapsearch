#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires openldap
%requires Util
%requires qore >= 2.3

%include qldaplib.ql

main();

const ScopeMap = {
    "base": LDAP_SCOPE_BASE,
    "one": LDAP_SCOPE_ONELEVEL,
    "sub": LDAP_SCOPE_SUBTREE,
    "children": LDAP_SCOPE_CHILDREN,
};

const SearchOpts = CommonOpts + {
    "base": "b,basedn=s",
    "scope": "s,scope=s",
    "ldif": "L,ldif",
    "pagesize": "p,page-size=i",
    "count": "c,count",
};

sub main() {
    GetOpt g(SearchOpts);
    hash opts = g.parse3(\ARGV);

    Util::TerminalColor color(!opts.nocolor);

    if (opts.help) {
        usage(color);
    }

    handle_common_opts(opts, color);

    if (opts.scope) {
        *int scope = ScopeMap{opts.scope};
        if (!exists scope) {
            ldap_error(color, "invalid scope %y (expecting one of %y)", opts.scope, ScopeMap.keys());
        }
        opts.scope = scope;
    }

    if (ARGV[0]) {
        opts.filter = shift ARGV;
        opts.attributes = ARGV;
    } else {
        opts.filter = "(objectClass=*)";
    }

    process_bind_password(\opts);
    string uri = get_uri(opts);
    hash lopt = opts{LdapOptionKeys};

    if (opts.verbose) {
        printf("%s %s\n", color.dim("uri:"), uri);
        printf("%s %s\n", color.dim("options:"), color.formatValue(lopt));
    }

    try {
        LdapClient ldap(uri, lopt);

        hash<auto> search_opts = opts.("base", "filter", "attributes", "scope");
        if (opts.pagesize > 0) {
            search_opts."page-size" = opts.pagesize;
        }

        hash<auto> result = ldap.search(search_opts);

        if (opts.count) {
            printf("%s %s\n", color.bold("Entries found:"), color.number(sprintf("%d", result.size())));
        } else if (opts.ldif) {
            foreach string dn in (keys result) {
                print_ldif_entry(dn, result{dn});
            }
        } else {
            foreach string dn in (keys result) {
                print_entry(color, dn, result{dn});
            }
            printf("%s %s\n", color.dim("# entries:"), color.number(sprintf("%d", result.size())));
        }
    } catch (hash<ExceptionInfo> ex) {
        ldap_error(color, "%s: %s", ex.err, ex.desc);
    }
}

sub usage(Util::TerminalColor color) {
    printf("%s %s [options] [filter] [attr ...]\n\n", color.bold("usage:"), get_script_name());
    printf("%s\n", color.bold("Search Options:"));
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-b,--basedn=ARG", 22)), "base dn for search");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-s,--scope=ARG", 22)), sprintf("search scope: %s", color.dim("base|one|sub|children")));
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-L,--ldif", 22)), "output in LDIF format");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-p,--page-size=ARG", 22)), "page size for paged results (RFC 2696)");
    printf("  %s  %s\n", color.key(TerminalColor::padRight("-c,--count", 22)), "show entry count only");
    printf("\n");
    print_common_usage(color);
    exit(0);
}
