        # test comparison that should return true
        bool result = ldap.compare(testEntryDn, "uid", "qoretest");
        assertTrue(result);

        # test comparison that should return false
        result = ldap.compare(testEntryDn, "uid", "wrongvalue");
        assertFalse(result);

        # test comparison with cn attribute
        result = ldap.compare(testEntryDn, "cn", "Qore Test User");
        assertTrue(result);
    }

