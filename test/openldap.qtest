    #! Test LdapClient::passwd() method
    testPasswd() {
        skipIfReadOnly("passwd() requires write access");
        LdapClient ldap = getClient();
        createTestEntry();

        # Note: passwd() requires the LDAP server to support the password modify extended operation
        # and the user must have permission to change passwords
        # This test may be skipped on servers that don't support this operation
        try {
            # change password
            ldap.passwd(testEntryDn, "testpassword", "newpassword123");

            # verify by binding with new password
            LdapClient ldap2(uri, {"binddn": testEntryDn, "password": "newpassword123"});
            hash<auto> result = ldap2.search({
                "base": testEntryDn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertTrue(result.hasKey(testEntryDn));

            # change it back
            ldap.passwd(testEntryDn, "newpassword123", "testpassword");
        } catch (hash<ExceptionInfo> ex) {
            # Some LDAP servers don't support passwd extended operation
            if (ex.err == "LDAP-RESULT-ERROR" && ex.desc =~ /unwilling to perform/i) {
                testSkip("LDAP server does not support password modify extended operation");
            } else {
                rethrow;
            }
        }
    }

    #! Test LdapClient::passwd() negative cases
    testPasswdNegative() {
        skipIfReadOnly("passwd() requires write access");
        LdapClient ldap = getClient();
        createTestEntry();

        # test passwd on non-existent entry
        assertThrows("LDAP-RESULT-ERROR", sub() {
            ldap.passwd("uid=nonexistent,ou=people,dc=example,dc=com", "oldpwd", "newpwd");
        });

        # test passwd with wrong old password
        try {
            assertThrows("LDAP-RESULT-ERROR", sub() {
                ldap.passwd(testEntryDn, "wrongoldpassword", "newpassword");
            });
        } catch (hash<ExceptionInfo> ex) {
            # Some LDAP servers don't support passwd extended operation
            if (ex.err == "LDAP-RESULT-ERROR" && ex.desc =~ /unwilling to perform/i) {
                testSkip("LDAP server does not support password modify extended operation");
            } else {
                rethrow;
            }
        }
    }

    #! Test LdapClient::copy() method
    testCopy() {
        LdapClient ldap = getClient();
        LdapClient ldap2 = ldap.copy();

        assertEq(ldap.getUri(), ldap2.getUri());

        # verify the copy works independently
        hash<auto> result = ldap2.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertEq(Type::Hash, result.type());

        # verify original still works after copy is used
        result = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertEq(Type::Hash, result.type());
    }

    #! Test LDAP constants
    testConstants() {
        # test scope constants exist and are integers
        assertEq(Type::Int, LDAP_SCOPE_BASE.type());
        assertEq(Type::Int, LDAP_SCOPE_ONELEVEL.type());
        assertEq(Type::Int, LDAP_SCOPE_SUBTREE.type());
        assertEq(Type::Int, LDAP_SCOPE_CHILDREN.type());

        # test scope constants have distinct values
        assertTrue(LDAP_SCOPE_BASE != LDAP_SCOPE_ONELEVEL);
        assertTrue(LDAP_SCOPE_ONELEVEL != LDAP_SCOPE_SUBTREE);
        assertTrue(LDAP_SCOPE_SUBTREE != LDAP_SCOPE_CHILDREN);

        # test modify constants
        assertEq("add", LDAP_MOD_ADD);
        assertEq("delete", LDAP_MOD_DELETE);
        assertEq("replace", LDAP_MOD_REPLACE);

        # test default timeout
        assertEq(60s, DefaultTimeout);
    }

    #! Test timeout functionality
    testTimeout() {
        # test with custom timeout in constructor
        {
            LdapClient ldap(uri, {
                "binddn": binddn,
                "password": password,
                "timeout": 5s,
            });

            hash<auto> result = ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertEq(Type::Hash, result.type());
        }

        # test with timeout parameter in search
        {
            LdapClient ldap = getClient();
            hash<auto> result = ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            }, 10s);
            assertEq(Type::Hash, result.type());
        }

        # test with very short timeout (should still work for local server)
        {
            LdapClient ldap = getClient();
            hash<auto> result = ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            }, 100ms);
            assertEq(Type::Hash, result.type());
        }
    }

