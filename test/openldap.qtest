        if (mails.typeCode() == NT_LIST) {
            assertEq(2, mails.size());
        }

        # cleanup
        ldap.del(testEntryDn);
    }

    #! Test LdapDn class
    testLdapDn() {
        # test basic DN parsing
        {
            LdapDn dn("uid=testuser,ou=people,dc=example,dc=com");
            assertEq("uid=testuser,ou=people,dc=example,dc=com", dn.toString());
            assertEq("uid=testuser", dn.getRdn());
            assertEq("testuser", dn.getRdnValue());
            assertEq("uid", dn.getRdnType());
            assertEq("ou=people,dc=example,dc=com", dn.getParent());
        }

        # test CN-based DN
        {
            LdapDn dn("cn=Admin Group,ou=groups,dc=example,dc=com");
            assertEq("cn=Admin Group", dn.getRdn());
            assertEq("Admin Group", dn.getRdnValue());
            assertEq("cn", dn.getRdnType());
        }

        # test single component DN
        {
            LdapDn dn("dc=com");
            assertEq("dc=com", dn.getRdn());
            assertEq("com", dn.getRdnValue());
            assertEq("", dn.getParent());
        }

        # test isChildOf
        {
            LdapDn dn("uid=test,ou=people,dc=example,dc=com");
            assertTrue(dn.isChildOf("dc=example,dc=com"));
            assertTrue(dn.isChildOf("ou=people,dc=example,dc=com"));
            assertFalse(dn.isChildOf("ou=groups,dc=example,dc=com"));
        }
    }

    #! Test LdapEntry class
    testLdapEntry() {
        # create test entry data
        hash<auto> attrs = {
            "objectClass": ("inetOrgPerson", "posixAccount"),
            "uid": "testuser",
            "cn": "Test User",
            "sn": "User",
            "mail": ("test@example.com", "test2@example.com"),
            "uidNumber": "1000",
        };
        string dn = "uid=testuser,ou=people,dc=example,dc=com";

        LdapEntry entry(dn, attrs);

        # test basic accessors
        assertEq(dn, entry.dn);
        assertEq("testuser", entry.getRdnValue());
        assertEq("uid", entry.getRdnType());
        assertEq("ou=people,dc=example,dc=com", entry.getParent());

        # test getAttribute
        assertEq("testuser", entry.getAttribute("uid"));
        assertEq("Test User", entry.getAttribute("cn"));

        # test getAttributeString (returns first value for multi-valued)
        assertEq("test@example.com", entry.getAttributeString("mail"));

        # test getAttributeList
        list<auto> mails = entry.getAttributeList("mail");
        assertEq(2, mails.size());
        assertTrue(inlist("test@example.com", mails));
        assertTrue(inlist("test2@example.com", mails));

        # test hasAttribute
        assertTrue(entry.hasAttribute("uid"));
        assertTrue(entry.hasAttribute("cn"));
        assertFalse(entry.hasAttribute("nonexistent"));

        # test getAttributeNames
        list<string> names = entry.getAttributeNames();
        assertTrue(inlist("uid", names));
        assertTrue(inlist("cn", names));
        assertTrue(inlist("objectClass", names));

        # test hasObjectClass
        assertTrue(entry.hasObjectClass("inetOrgPerson"));
        assertTrue(entry.hasObjectClass("posixAccount"));
        assertFalse(entry.hasObjectClass("person"));

        # test toHash
        hash<auto> h = entry.toHash();
        assertTrue(h.hasKey("dn"));
        assertEq(dn, h.dn);
    }

    #! Test LdapSearchIterator class
    testLdapSearchIterator() {
        LdapClient ldap = getClient();

        # perform a search
        hash<auto> results = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_ONELEVEL,
        });

        # create iterator
        LdapSearchIterator iter(results);

        # test size
        assertEq(results.size(), iter.size());

        # test iteration
        int count = 0;
        while (iter.next()) {
            assertTrue(iter.valid());
            LdapEntry entry = iter.getValue();
            assertEq(Type::Object, entry.type());
            assertTrue(entry.dn.size() > 0);
            count++;
        }
        assertEq(results.size(), count);

        # test reset
        iter.reset();
        assertFalse(iter.valid());
        assertTrue(iter.next());
        assertTrue(iter.valid());

        # test getAll
        iter.reset();
        list<LdapEntry> entries = iter.getAll();
        assertEq(results.size(), entries.size());
    }

    #! Test LdapClientHelper class
    testLdapClientHelper() {
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }
        LdapClientHelper helper(uri, opts);

        # test ping
        assertTrue(helper.ping());

        # test entryExists
        assertTrue(helper.entryExists(basedn));
        assertFalse(helper.entryExists("cn=nonexistent,dc=invalid,dc=com"));

        # test getEntry
        {
            *LdapEntry entry = helper.getEntry(basedn);
            assertTrue(exists entry);
            assertEq(basedn, entry.dn);
        }

        # test getEntry for non-existent
        {
            *LdapEntry entry = helper.getEntry("cn=nonexistent,dc=example,dc=com");
            assertFalse(exists entry);
        }

        # test searchIterator
        {
            LdapSearchIterator iter = helper.searchIterator({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertTrue(iter.size() >= 1);
        }

        # test searchEntries
        {
            list<LdapEntry> entries = helper.searchEntries({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertTrue(entries.size() >= 1);
        }

        # test getClient
        LdapClient client = helper.getClient();
        assertEq(uri, client.getUri());
    }

    #! Test LdapConnectionPool basic operations
    testConnectionPool() {
        # test pool creation
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }
        LdapConnectionPool pool(uri, opts, {
            "min_connections": 1,
            "max_connections": 3,
        });

        assertEq(uri, pool.getUri());

        # test stats after creation
        hash<auto> stats = pool.getStats();
        assertEq(1, stats.min);
        assertEq(3, stats.max);
        assertTrue(stats.available >= 1);
        assertEq(0, stats.in_use);

        # test getting a connection
        LdapClient conn1 = pool.get();
        stats = pool.getStats();
        assertEq(1, stats.in_use);

        # verify connection works
        hash<auto> result = conn1.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertEq(Type::Hash, result.type());

        # test releasing connection
        pool.release(conn1);
        stats = pool.getStats();
        assertEq(0, stats.in_use);
        assertTrue(stats.available >= 1);

        # test getting multiple connections
        LdapClient c1 = pool.get();
        LdapClient c2 = pool.get();
        stats = pool.getStats();
        assertEq(2, stats.in_use);

        pool.release(c1);
        pool.release(c2);

        # test close
        pool.close();
    }

    #! Test LdapConnectionPool withConnection pattern
    testConnectionPoolWithConnection() {
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }
        LdapConnectionPool pool(uri, opts, {
            "min_connections": 1,
            "max_connections": 5,
        });

        # test withConnection callback
        pool.withConnection(sub(LdapClient ldap) {
            hash<auto> result = ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertEq(Type::Hash, result.type());
        });

        # verify connection was returned to pool
        hash<auto> stats = pool.getStats();
        assertEq(0, stats.in_use);

        # test withConnectionResult
        hash<auto> result = pool.withConnectionResult(hash<auto> sub(LdapClient ldap) {
            return ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
        });
        assertEq(Type::Hash, result.type());

        # test exception handling in withConnection
        bool exceptionThrown = False;
        try {
            pool.withConnection(sub(LdapClient ldap) {
                throw "TEST-ERROR", "test exception";
            });
        } catch (hash<ExceptionInfo> ex) {
            exceptionThrown = True;
            assertEq("TEST-ERROR", ex.err);
        }
        assertTrue(exceptionThrown);

        # verify connection was still returned despite exception
        stats = pool.getStats();
        assertEq(0, stats.in_use);

        pool.close();
    }

    #! Test LdapDn corner cases
    testLdapDnCornerCases() {
        # test empty DN
        {
            LdapDn dn("");
            assertEq("", dn.toString());
            assertEq("", dn.getRdn());
            assertEq("", dn.getRdnValue());
            assertEq("", dn.getRdnType());
            assertEq("", dn.getParent());
        }

        # test DN with spaces (getRdn returns raw string, getRdnType/Value are trimmed)
        {
            LdapDn dn("cn = Test User , ou = people , dc = example , dc = com");
            assertEq("cn = Test User", dn.getRdn());
            assertEq("Test User", dn.getRdnValue());
            assertEq("cn", dn.getRdnType());
        }

        # test DN without equals sign (malformed) — stored as raw string but no type/value
        {
            LdapDn dn("malformed-dn");
            assertEq("malformed-dn", dn.toString());
            assertEq("malformed-dn", dn.getRdn());
            assertEq("", dn.getRdnValue());
            assertEq("", dn.getRdnType());
        }

        # test DN with only one component
        {
            LdapDn dn("uid=single");
            assertEq("uid=single", dn.getRdn());
            assertEq("single", dn.getRdnValue());
            assertEq("uid", dn.getRdnType());
            assertEq("", dn.getParent());
        }

        # test isChildOf with empty parent
        {
            LdapDn dn("uid=test,dc=example,dc=com");
            assertTrue(dn.isChildOf("dc=com"));
            assertFalse(dn.isChildOf(""));  # empty parent - find returns -1 which is not > 0
        }
    }

    #! Test LdapEntry corner cases
    testLdapEntryCornerCases() {
        # test entry with empty attributes
        {
            LdapEntry entry("dc=example,dc=com", {});
            assertEq("dc=example,dc=com", entry.dn);
            assertFalse(entry.hasAttribute("any"));
            assertFalse(exists entry.getAttribute("any"));
            assertFalse(exists entry.getAttributeString("any"));
            assertEq(0, entry.getAttributeList("any").size());
            assertEq(0, entry.getAttributeNames().size());
        }

        # test entry with single-valued objectClass
        {
            hash<auto> attrs = {
                "objectClass": "top",
                "dc": "example",
            };
            LdapEntry entry("dc=example,dc=com", attrs);
            assertTrue(entry.hasObjectClass("top"));
            assertTrue(entry.hasObjectClass("TOP"));  # case-insensitive
            assertFalse(entry.hasObjectClass("organization"));
        }

        # test entry with no objectClass
        {
            hash<auto> attrs = {
                "dc": "example",
            };
            LdapEntry entry("dc=example,dc=com", attrs);
            assertFalse(entry.hasObjectClass("anything"));
        }

        # test getAttributeString with single value
        {
            hash<auto> attrs = {
                "cn": "Single Value",
            };
            LdapEntry entry("cn=test,dc=example,dc=com", attrs);
            assertEq("Single Value", entry.getAttributeString("cn"));
        }

        # test getAttributeList with single value
        {
            hash<auto> attrs = {
                "cn": "Single Value",
            };
            LdapEntry entry("cn=test,dc=example,dc=com", attrs);
            list<auto> values = entry.getAttributeList("cn");
            assertEq(1, values.size());
            assertEq("Single Value", values[0]);
        }

        # test toString
        {
            LdapEntry entry("uid=test,dc=example,dc=com", {"uid": "test"});
            assertEq("LdapEntry(uid=test,dc=example,dc=com)", entry.toString());
        }
    }

    #! Test LdapSearchIterator corner cases and negative cases
    testLdapSearchIteratorNegative() {
        # test with empty results
        {
            LdapSearchIterator iter({});
            assertEq(0, iter.size());
            assertFalse(iter.next());
            assertFalse(iter.valid());
            assertEq(0, iter.getAll().size());
        }

        # test getValue before next() - should throw
        {
            hash<auto> results = {"dn1": {"attr": "value"}};
            LdapSearchIterator iter(results);
            assertThrows("ITERATOR-ERROR", sub() {
                iter.getValue();
            });
        }

        # test getValue after exhausted - should throw
        {
            hash<auto> results = {"dn1": {"attr": "value"}};
            LdapSearchIterator iter(results);
            assertTrue(iter.next());  # move to first
            assertFalse(iter.next()); # exhaust
            assertThrows("ITERATOR-ERROR", sub() {
                iter.getValue();
            });
        }

        # test reset and re-iterate
        {
            hash<auto> results = {
                "dn1": {"cn": "Entry 1"},
                "dn2": {"cn": "Entry 2"},
            };
            LdapSearchIterator iter(results);

            # iterate once
            int count1 = 0;
            while (iter.next()) {
                count1++;
            }
            assertEq(2, count1);

            # reset and iterate again
            iter.reset();
            int count2 = 0;
            while (iter.next()) {
                count2++;
            }
            assertEq(2, count2);
        }
    }

    #! Test LdapClientHelper corner cases
    testLdapClientHelperCornerCases() {
        LdapClientHelper helper(uri, {"binddn": binddn, "password": password});

        # test getEntry with specific attributes
        {
            *LdapEntry entry = helper.getEntry(basedn, ("objectClass",));
            assertTrue(exists entry);
            assertTrue(entry.hasAttribute("objectClass"));
        }

        # test creating helper from existing client
        {
            LdapClient client = getClient();
            LdapClientHelper helper2(client);
            assertTrue(helper2.ping());
            assertEq(uri, helper2.getClient().getUri());
        }

        # test methodGate delegation
        {
            string gotUri = helper.getUri();
            assertEq(uri, gotUri);
        }

        # test entryExists with timeout
        {
            assertTrue(helper.entryExists(basedn, 10s));
        }

        # test searchEntries returns entries with proper DN
        {
            list<LdapEntry> entries = helper.searchEntries({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertTrue(entries.size() >= 1);
            assertTrue(entries[0].dn.size() > 0);
        }
    }

    #! Test LdapConnectionPool negative cases
    testConnectionPoolNegative() {
        # test invalid min_connections (negative)
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {"min_connections": -1});
        });

        # test invalid max_connections (less than 1)
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {"max_connections": 0});
        });

        # test min > max
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {
                "min_connections": 5,
                "max_connections": 2,
            });
        });

        # test releasing connection not from pool
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 0,
                "max_connections": 2,
            });

            # create a separate client not from pool
            LdapClient externalClient(uri, opts);

            # releasing external connection should throw
            assertThrows("LDAP-POOL-ERROR", sub() {
                pool.release(externalClient);
            });

            pool.close();
        }

        # test double release
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 0,
                "max_connections": 2,
            });

            LdapClient conn = pool.get();
            pool.release(conn);

            # second release should throw
            assertThrows("LDAP-POOL-ERROR", sub() {
                pool.release(conn);
            });

            pool.close();
        }

        # test get after shutdown
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 1,
                "max_connections": 2,
            });

            pool.close();

            assertThrows("LDAP-POOL-SHUTDOWN", sub() {
                pool.get();
            });
        }
    }

