    #! Test paged results
    testPagedResults() {
        LdapClient ldap = getClient();

        # search with page-size option
        hash<auto> result = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_SUBTREE,
            "page-size": 2,
        });
        assertEq(Type::Hash, result.type());
        # should get at least the base entry + sub-entries
        assertTrue(result.size() >= 1);

        # compare with non-paged search to verify same results
        hash<auto> nonPaged = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_SUBTREE,
        });
        assertEq(nonPaged.size(), result.size());

        # page-size of 1 (extreme case)
        result = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_SUBTREE,
            "page-size": 1,
        });
        assertEq(nonPaged.size(), result.size());
    }

    #! Test SASL bind negative cases
    testSaslBindNegative() {
        LdapClient ldap(uri);

        # missing mechanism
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"password": "test"});
        });

        # unsupported mechanism (server may not support DIGEST-MD5)
        assertThrows("LDAP-ERROR", sub() {
            ldap.saslBind({"mechanism": "DIGEST-MD5", "authcid": "test", "password": "wrong"});
        });

        # invalid SASL hardening option types and values are rejected before binding
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "secprops": ""});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "secprops": 1});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "ssf-min": "128"});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "ssf-max": -1});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "maxbufsize": -1});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "external-ssf": -1});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "nocanon": 1});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "channel-binding": "tls-exporter"});
        });
        assertThrows("LDAP-SASL-BIND-ERROR", sub() {
            ldap.saslBind({"mechanism": "GSSAPI", "channel-binding": -1});
        });
    }

    #! Helper: check if SASL server is configured
    private bool hasSaslServer() {
        return exists saslUri;
    }

    #! Test SASL DIGEST-MD5 bind (requires LDAP_SASL_URI)
    testSaslDigestMd5() {
        if (!hasSaslServer()) {
            testSkip("Skipped: set LDAP_SASL_URI to enable SASL tests (e.g., ldap://localhost:2389)");
            return;
        }
        LdapClient ldap(saslUri);

        # perform DIGEST-MD5 bind
        ldap.saslBind({
            "mechanism": "DIGEST-MD5",
            "authcid": saslUser,
            "password": saslPassword,
        });

        # verify we can search after SASL bind
        hash<auto> result = ldap.search({
            "base": "dc=example,dc=com",
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertTrue(result.size() > 0);
    }

