    #! Test LdapConnectionPool cleanup functionality
    testConnectionPoolCleanup() {
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }
        LdapConnectionPool pool(uri, opts, {
            "min_connections": 1,
            "max_connections": 5,
            "idle_timeout": 1,  # 1 second
        });

        # get and release some connections to populate pool
        LdapClient c1 = pool.get();
        LdapClient c2 = pool.get();
        pool.release(c1);
        pool.release(c2);

        hash<auto> stats = pool.getStats();
        assertTrue(stats.available >= 2);

        # wait for idle timeout
        sleep(2s);

        # run cleanup
        pool.cleanupIdleConnections();

        # should have removed some connections but kept at least min_connections
        stats = pool.getStats();
        assertTrue(stats.total >= 1);  # min_connections

        pool.close();
    }

