        assertEq("1.3.6.1.4.1.4203.1.11.3", LDAP_EXOP_WHO_AM_I);
        assertEq("1.3.6.1.1.8", LDAP_EXOP_CANCEL);
        assertEq("1.3.6.1.4.1.4203.1.11.1", LDAP_EXOP_MODIFY_PASSWD);
        assertEq("1.3.6.1.4.1.1466.20037", LDAP_EXOP_START_TLS);
