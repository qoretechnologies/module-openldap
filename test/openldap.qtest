    #! Test LdapConnectionPool negative cases
    testConnectionPoolNegative() {
        # test invalid min_connections (negative)
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {"min_connections": -1});
        });

        # test invalid max_connections (less than 1)
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {"max_connections": 0});
        });

        # test min > max
        assertThrows("LDAP-POOL-ERROR", sub() {
            new LdapConnectionPool(uri, {}, {
                "min_connections": 5,
                "max_connections": 2,
            });
        });

        # test releasing connection not from pool
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 0,
                "max_connections": 2,
            });

            # create a separate client not from pool
            LdapClient externalClient(uri, opts);

            # releasing external connection should throw
            assertThrows("LDAP-POOL-ERROR", sub() {
                pool.release(externalClient);
            });

            pool.close();
        }

        # test double release
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 0,
                "max_connections": 2,
            });

            LdapClient conn = pool.get();
            pool.release(conn);

            # second release should throw
            assertThrows("LDAP-POOL-ERROR", sub() {
                pool.release(conn);
            });

            pool.close();
        }

        # test get after shutdown
        {
            hash<auto> opts;
            if (binddn.val()) {
                opts = {"binddn": binddn, "password": password};
            }
            LdapConnectionPool pool(uri, opts, {
                "min_connections": 1,
                "max_connections": 2,
            });

            pool.close();

            assertThrows("LDAP-POOL-SHUTDOWN", sub() {
                pool.get();
            });
        }
    }

    #! Test LdapConnectionPool cleanup functionality
    testConnectionPoolCleanup() {
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }
        LdapConnectionPool pool(uri, opts, {
            "min_connections": 1,
            "max_connections": 5,
            "idle_timeout": 1,  # 1 second
        });

        # get and release some connections to populate pool
        LdapClient c1 = pool.get();
        LdapClient c2 = pool.get();
        pool.release(c1);
        pool.release(c2);

        hash<auto> stats = pool.getStats();
        assertTrue(stats.available >= 2);

        # wait for idle timeout
        sleep(2s);

        # run cleanup
        pool.cleanupIdleConnections();

        # should have removed some connections but kept at least min_connections
        stats = pool.getStats();
        assertTrue(stats.total >= 1);  # min_connections

        pool.close();
    }
}
