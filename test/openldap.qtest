    #! Test LdapClient::rename() method
    testRename() {
        skipIfReadOnly("rename() requires write access");
        LdapClient ldap = getClient();
        createTestEntry();

        string newRdn = "uid=qoretest-renamed";
        string renamedDn = newRdn + "," + peopledn;

        # rename the entry
        ldap.rename(testEntryDn, newRdn, peopledn);

        # verify old entry no longer exists (search returns empty)
        hash<auto> result = ldap.search({
            "base": peopledn,
            "filter": "(uid=qoretest)",
            "scope": LDAP_SCOPE_SUBTREE,
        });
        assertEq(0, result.size());

        # verify new entry exists
        result = ldap.search({
            "base": renamedDn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertTrue(result.hasKey(renamedDn));

        # rename it back for cleanup
        ldap.rename(renamedDn, "uid=qoretest", peopledn);
    }

