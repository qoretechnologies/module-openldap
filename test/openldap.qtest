    #! Test control OID constants
    testControlConstants() {
        assertEq(Type::String, LDAP_CONTROL_PAGEDRESULTS.type());
        assertEq("1.2.840.113556.1.4.319", LDAP_CONTROL_PAGEDRESULTS);
        assertEq("1.2.840.113556.1.4.473", LDAP_CONTROL_SORTREQUEST);
        assertEq("1.2.840.113556.1.4.474", LDAP_CONTROL_SORTRESPONSE);
        assertEq("2.16.840.1.113730.3.4.9", LDAP_CONTROL_VLVREQUEST);
        assertEq("2.16.840.1.113730.3.4.10", LDAP_CONTROL_VLVRESPONSE);
        assertEq("2.16.840.1.113730.3.4.18", LDAP_CONTROL_PROXY_AUTHZ);
        assertEq("2.16.840.1.113730.3.4.2", LDAP_CONTROL_MANAGEDSAIT);
        assertEq("1.2.840.113556.1.4.417", LDAP_CONTROL_SHOW_DELETED);
        assertEq("1.2.840.113556.1.4.2064", LDAP_CONTROL_SHOW_RECYCLED);
        assertEq("1.3.6.1.4.1.42.2.27.8.5.1", LDAP_CONTROL_PASSWORDPOLICYREQUEST);
        assertEq("1.3.6.1.1.12", LDAP_CONTROL_ASSERTION);
        assertEq("1.3.6.1.1.13.1", LDAP_CONTROL_PRE_READ);
        assertEq("1.3.6.1.1.13.2", LDAP_CONTROL_POST_READ);
    }

    #! Test controls parameter on search (empty controls = backwards compat)
    testControlsParameter() {
        LdapClient ldap = getClient();

        # search with empty controls (backwards compatible)
        hash<auto> result = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        }, NOTHING, ());
        assertEq(Type::Hash, result.type());
        assertTrue(result.hasKey(basedn));

        # search with controls in the search options hash
        result = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
            "controls": (),
        });
        assertEq(Type::Hash, result.type());
        assertTrue(result.hasKey(basedn));

        # add with empty controls
        if (canWrite()) {
            cleanupTestEntry();
            ldap.add(testEntryDn, {
                "objectClass": ("inetOrgPerson", "posixAccount", "shadowAccount"),
                "uid": "qoretest", "cn": "Test", "sn": "Test",
                "uidNumber": "99999", "gidNumber": "99999",
                "homeDirectory": "/home/qoretest",
            }, NOTHING, ());
            ldap.del(testEntryDn, NOTHING, ());
        }
    }

    #! Test controls parameter negative cases
    testControlsNegative() {
        LdapClient ldap = getClient();

        # malformed control (not a hash)
        assertThrows("LDAP-CONTROL-ERROR", sub() {
            ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            }, NOTHING, ("not-a-hash",));
        });

        # control hash missing OID
        assertThrows("LDAP-CONTROL-ERROR", sub() {
            ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            }, NOTHING, ({"critical": True},));
        });

        # control with invalid value type
        assertThrows("LDAP-CONTROL-ERROR", sub() {
            ldap.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            }, NOTHING, ({"oid": "1.2.3.4", "value": 12345},));
        });
    }

    #! Test RFC 4514 DN escaping
    testDnEscaping() {
        # escaped comma in value
        {
            LdapDn dn("CN=Smith\\, John,OU=Users,DC=example,DC=com");
            assertEq("CN=Smith\\, John", dn.getRdn());
            assertEq("Smith, John", dn.getRdnValue());
            assertEq("CN", dn.getRdnType());
            assertEq("OU=Users,DC=example,DC=com", dn.getParent());
            assertEq(4, dn.depth());
        }

        # hex-escaped characters
        {
            LdapDn dn("CN=Test\\2CUser,DC=example,DC=com");
            assertEq("Test,User", dn.getRdnValue());
        }

        # escaped special characters
        {
            LdapDn dn("CN=Test\\+Special\\=Chars,DC=example,DC=com");
            assertEq("Test+Special=Chars", dn.getRdnValue());
        }

        # escape/unescape round-trip
        {
            string raw = "Smith, John+Jr.";
            string escaped = LdapDn::escape(raw);
            assertTrue(escaped.find("\\,") >= 0);
            assertTrue(escaped.find("\\+") >= 0);
            string unescaped = LdapDn::unescape(escaped);
            assertEq(raw, unescaped);
        }

        # escape leading # and space
        {
            assertEq("\\#hash", LdapDn::escape("#hash"));
            assertEq("\\ leading", LdapDn::escape(" leading"));
            assertEq("trailing\\ ", LdapDn::escape("trailing "));
        }

        # simple DN still works
        {
            LdapDn dn("uid=test,ou=people,dc=example,dc=com");
            assertEq("uid=test", dn.getRdn());
            assertEq("test", dn.getRdnValue());
            assertEq("uid", dn.getRdnType());
            assertEq("ou=people,dc=example,dc=com", dn.getParent());
        }

        # empty DN
        {
            LdapDn dn("");
            assertEq("", dn.getRdn());
            assertEq("", dn.getRdnValue());
            assertEq("", dn.getParent());
            assertEq(0, dn.depth());
        }
    }

    #! Test multi-valued RDN support
    testDnMultiValued() {
        # multi-valued RDN with +
        {
            LdapDn dn("CN=Test+UID=tuser,DC=example,DC=com");
            list<hash<RdnComponent>> parts = dn.getRdnComponents();
            assertEq(2, parts.size());
            assertEq("CN", parts[0].type);
            assertEq("Test", parts[0].value);
            assertEq("UID", parts[1].type);
            assertEq("tuser", parts[1].value);
        }

        # escaped + in value (not a multi-valued separator)
        {
            LdapDn dn("CN=A\\+B,DC=example,DC=com");
            list<hash<RdnComponent>> parts = dn.getRdnComponents();
            assertEq(1, parts.size());
            assertEq("A+B", parts[0].value);
        }
    }

    #! Test binary attribute handling
    testBinaryAttributes() {
        skipIfReadOnly("binary attribute test requires write access");
        LdapClient ldap = getClient();
        cleanupTestEntry();

        # create entry with userPassword (a known binary attribute)
        hash<auto> attrs = {
            "objectClass": ("inetOrgPerson", "posixAccount", "shadowAccount"),
            "uid": "qoretest", "cn": "Test", "sn": "Test",
            "uidNumber": "99999", "gidNumber": "99999",
            "homeDirectory": "/home/qoretest",
            "userPassword": "testpass",
        };
        ldap.add(testEntryDn, attrs);

        # default: userPassword returned as binary (it's in the known-binary list)
        hash<auto> result = ldap.search({
            "base": testEntryDn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
            "attributes": ("uid", "userPassword"),
        });
        assertTrue(result.hasKey(testEntryDn));
        # userPassword is in the default binary list
        auto upwd = result{testEntryDn}.userPassword;
        assertEq(NT_BINARY, upwd.typeCode());

        # uid should still be a string
        assertEq(Type::String, result{testEntryDn}.uid.type());

        ldap.del(testEntryDn);
    }

    #! Test per-search binary attribute override
    testBinaryAttributeSearch() {
        skipIfReadOnly("binary attribute search test requires write access");
        LdapClient ldap = getClient();
        cleanupTestEntry();

        hash<auto> attrs = {
            "objectClass": ("inetOrgPerson", "posixAccount", "shadowAccount"),
            "uid": "qoretest", "cn": "Test", "sn": "Test",
            "uidNumber": "99999", "gidNumber": "99999",
            "homeDirectory": "/home/qoretest",
            "description": "test description",
        };
        ldap.add(testEntryDn, attrs);

        # per-search binary-attributes: force "description" to be binary
        hash<auto> result = ldap.search({
            "base": testEntryDn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
            "attributes": ("description",),
            "binary-attributes": ("description",),
        });
        assertTrue(result.hasKey(testEntryDn));
        assertEq(NT_BINARY, result{testEntryDn}.description.typeCode());

        # same search without binary-attributes: description should be string
        result = ldap.search({
            "base": testEntryDn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
            "attributes": ("description",),
        });
        assertEq(Type::String, result{testEntryDn}.description.type());

        # all-binary constructor option
        {
            hash allbin_opts = {
                "all-binary": True,
            };
            if (binddn.val()) {
                allbin_opts.binddn = binddn;
                allbin_opts.password = password;
            }
            LdapClient allbin(uri, allbin_opts);
            result = allbin.search({
                "base": testEntryDn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
                "attributes": ("uid",),
            });
            assertEq(NT_BINARY, result{testEntryDn}.uid.typeCode());
        }

        ldap.del(testEntryDn);
    }

    #! Test extendedOp (Who Am I?)
    testExtendedOp() {
        skipIfReadOnly("extended op test requires bind");
        LdapClient ldap = getClient();

        # Who Am I? extended operation
        hash<auto> result = ldap.extendedOp(LDAP_EXOP_WHO_AM_I);
        assertEq(Type::Hash, result.type());
