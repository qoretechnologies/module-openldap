    #! Test async operations
    testLdapAsync() {
        LdapClient client = getClient();
        hash<auto> asyncOpts;
        if (binddn.val()) {
            asyncOpts = {"binddn": binddn, "password": password};
        }
        LdapAsyncClient async(uri, asyncOpts);

        # async parallel search
        LdapFuture f1 = async.searchAsync({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });

        # should complete and return a hash
        auto r1 = f1.get(30s);
        assertEq(Type::Hash, r1.type());
        assertTrue(r1.size() > 0);

        # isDone should be true after get
        assertTrue(f1.isDone());

        # searchParallel
        list<LdapFuture> futures = async.searchParallel(({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        }, {
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        }));
        assertEq(2, futures.size());
        auto pr1 = futures[0].get(30s);
        auto pr2 = futures[1].get(30s);
        assertEq(Type::Hash, pr1.type());
        assertEq(Type::Hash, pr2.type());

        # async add/del
        if (canWrite()) {
            cleanupTestEntry();
            LdapFuture af = async.addAsync(testEntryDn, {
                "objectClass": ("inetOrgPerson", "posixAccount", "shadowAccount"),
                "uid": "qoretest", "cn": "Test", "sn": "Test",
                "uidNumber": "99999", "gidNumber": "99999",
                "homeDirectory": "/home/qoretest",
            });
            af.get(30s);  # wait for add to complete

            # verify it exists
            hash<auto> verify = client.search({
                "base": testEntryDn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
            assertTrue(verify.hasKey(testEntryDn));

            # async delete
            LdapFuture df = async.delAsync(testEntryDn);
            df.get(30s);
        }
    }

    #! Test async error propagation
    testLdapAsyncErrors() {
        LdapAsyncClient async("ldap://localhost:1");

        # search with invalid base DN should throw
        LdapFuture f = async.searchAsync({
            "base": "cn=nonexistent,dc=nonexistent,dc=invalid",
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });

        # error should propagate through the Future
        bool got_error = False;
        try {
            f.get(30s);
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            # should be an LDAP error
            assertTrue(ex.err =~ /LDAP/);
        }
        assertTrue(got_error);
        assertTrue(f.isDone());
    }

    #! Test LDAP URL parsing
    testLdapUrl() {
        # basic URL
        {
            LdapUrl url("ldap://ldap.example.com/dc=example,dc=com");
            assertEq("ldap", url.scheme);
            assertEq("ldap.example.com", url.host);
            assertFalse(exists url.port);
            assertEq("dc=example,dc=com", url.baseDn);
        }

        # full URL with all components
        {
            LdapUrl url("ldap://ldap.example.com:389/dc=example,dc=com?cn,sn?sub?(objectClass=*)");
            assertEq("ldap", url.scheme);
            assertEq("ldap.example.com", url.host);
            assertEq(389, url.port);
            assertEq("dc=example,dc=com", url.baseDn);
            assertEq(("cn", "sn"), url.attributes);
            assertEq("sub", url.scope);
            assertEq("(objectClass=*)", url.filter);
        }

        # ldaps scheme
        {
            LdapUrl url("ldaps://secure.example.com:636/dc=test,dc=com");
            assertEq("ldaps", url.scheme);
            assertEq("secure.example.com", url.host);
            assertEq(636, url.port);
        }

        # toSearchOpts
        {
            LdapUrl url("ldap://host/dc=test?cn,sn?one?(uid=test)");
            hash<auto> opts = url.toSearchOpts();
            assertEq("dc=test", opts.base);
            assertEq("(uid=test)", opts.filter);
            assertEq(("cn", "sn"), opts.attributes);
            assertEq(LDAP_SCOPE_ONELEVEL, opts.scope);
        }

        # getServerUri
        {
            LdapUrl url("ldap://host:389/base");
            assertEq("ldap://host:389", url.getServerUri());
        }
    }

    #! Test LDAP URL corner cases
    testLdapUrlCornerCases() {
        # URL with no base
        {
            LdapUrl url("ldap://host/");
            assertEq("host", url.host);
            assertFalse(exists url.baseDn);
        }

        # URL with no path
        {
            LdapUrl url("ldap://host");
            assertEq("host", url.host);
        }

        # invalid scheme
        assertThrows("LDAP-URL-ERROR", sub() {
            new LdapUrl("http://host/");
        });

        # toString round-trip
        {
            string original = "ldap://host:389/dc=test";
            LdapUrl url(original);
            assertEq(original, url.toString());
        }
    }

    #! Test schema introspection
    #! Test rootDSE search (base="", scope=BASE)
    testRootDseSearch() {
        LdapClient ldap = getClient();

        # rootDSE search should return exactly 1 entry with empty DN key
        hash<auto> r = ldap.search({
            "base": "",
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
            "attributes": ("namingContexts", "supportedSASLMechanisms", "supportedExtension"),
        });
        assertEq(1, r.size());
        assertTrue(r.hasKey(""));

        # verify rootDSE attributes
        hash<auto> rootDse = r{""};
        assertTrue(rootDse.hasKey("namingContexts"));
        assertEq("dc=example,dc=com", rootDse.namingContexts);

        # supported extensions should be present (Who Am I?, passwd modify, etc.)
        assertTrue(rootDse.hasKey("supportedExtension"));
    }

    #! Test LDAP_SCOPE_BASE returns exactly 1 entry
    testScopeBaseCorrectness() {
        LdapClient ldap = getClient();

        # SCOPE_BASE on a subtree base should return exactly 1 entry (the base itself)
        hash<auto> r = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_BASE,
        });
        assertEq(1, r.size());
        assertTrue(r.hasKey(basedn));

        # Compare with SCOPE_SUBTREE which should return more
        hash<auto> r2 = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_SUBTREE,
        });
        assertTrue(r2.size() > 1);

        # SCOPE_ONELEVEL should return immediate children only (not the base)
        hash<auto> r3 = ldap.search({
            "base": basedn,
            "filter": "(objectClass=*)",
            "scope": LDAP_SCOPE_ONELEVEL,
        });
        assertTrue(r3.size() >= 1);
        assertFalse(r3.hasKey(basedn));
    }

    testLdapSchema() {
        LdapClient ldap = getClient();

        LdapSchema schema(ldap);

        # schema should load successfully now that rootDSE search works
        list<string> ocNames = schema.getObjectClassNames();
        list<string> atNames = schema.getAttributeTypeNames();

        assertTrue(ocNames.size() > 0);
        assertTrue(atNames.size() > 0);

        # verify well-known "top" object class
        *hash<LdapObjectClassInfo> top = schema.getObjectClass("top");
        assertTrue(exists top);
        assertEq("top", top.name);
        assertEq("ABSTRACT", top.kind);
        assertTrue(inlist("objectClass", top.must));

        # verify well-known "cn" attribute type
        *hash<LdapAttributeTypeInfo> cn = schema.getAttributeType("cn");
        assertTrue(exists cn);
        assertEq("cn", cn.name);

        # verify getRequiredAttributes
        list<string> topMust = schema.getRequiredAttributes("top");
        assertTrue(inlist("objectClass", topMust));

        # verify getOptionalAttributes returns a list
        list<string> topMay = schema.getOptionalAttributes("top");
        assertEq(Type::List, topMay.type());

        # test non-existent class returns NOTHING
        assertFalse(exists schema.getObjectClass("nonExistentClass12345"));
        assertFalse(exists schema.getAttributeType("nonExistentAttr12345"));
    }

    #! Test LDIF reader
    testLdifReader() {
        # create a test LDIF string
        list<string> lines = (
            "dn: dc=example,dc=com",
            "objectClass: top",
            "objectClass: domain",
            "dc: example",
            "",
            "dn: ou=people,dc=example,dc=com",
            "objectClass: organizationalUnit",
            "ou: people",
            "description:: VGVzdCBkZXNjcmlwdGlvbg==",
            "",
        );

        LdifReader reader(lines);

        # read first entry
        *hash<LdifEntryInfo> entry1 = reader.readEntry();
        assertTrue(exists entry1);
        assertEq("dc=example,dc=com", entry1.dn);
        assertEq("top", entry1.attributes.objectClass[0]);
        assertEq("domain", entry1.attributes.objectClass[1]);
        assertEq("example", entry1.attributes.dc);

        # read second entry
        *hash<LdifEntryInfo> entry2 = reader.readEntry();
        assertTrue(exists entry2);
        assertEq("ou=people,dc=example,dc=com", entry2.dn);
        assertEq("organizationalUnit", entry2.attributes.objectClass);
        # base64-decoded value
        assertEq("Test description", entry2.attributes.description);

        # end of entries
        *hash<LdifEntryInfo> entry3 = reader.readEntry();
        assertFalse(exists entry3);
    }

    #! Test LDIF writer
    testLdifWriter() {
        # write to a temp file
        string tmpFile = "/tmp/qore-ldif-test-" + string(getpid()) + ".ldif";
        {
            LdifWriter writer(tmpFile);
            writer.writeComment("Test LDIF file");
            writer.writeEntry("dc=example,dc=com", {
                "objectClass": ("top", "domain"),
                "dc": "example",
            });
            writer.writeEntry("ou=people,dc=example,dc=com", {
                "objectClass": "organizationalUnit",
                "ou": "people",
            });
        }

        # read it back
        LdifReader reader(tmpFile);
        list<hash<LdifEntryInfo>> entries = reader.readAll();
        assertEq(2, entries.size());
        assertEq("dc=example,dc=com", entries[0].dn);
        assertEq("ou=people,dc=example,dc=com", entries[1].dn);

        # cleanup
        unlink(tmpFile);
    }

    #! Test connection pool reconnect/health check functionality
    testConnectionPoolReconnect() {
        hash<auto> opts;
        if (binddn.val()) {
            opts = {"binddn": binddn, "password": password};
        }

        # test pool with health check enabled
        LdapConnectionPool pool(uri, opts, {
            "min_connections": 1,
            "max_connections": 3,
            "health_check": True,
            "reconnect": True,
            "max_reconnect_retries": 2,
            "reconnect_delay": 1,
        });

        # withConnectionRetry should work for normal operations
        auto result = pool.withConnectionRetry(auto sub(LdapClient conn) {
            return conn.search({
                "base": basedn,
                "filter": "(objectClass=*)",
                "scope": LDAP_SCOPE_BASE,
            });
        });
        assertEq(Type::Hash, result.type());

        # test isConnectionError static method
        assertTrue(LdapConnectionPool::isConnectionError(cast<hash<ExceptionInfo>>({
            "err": "LDAP-ERROR",
            "desc": "ldap server 'ldap://host' returned error code -1 when calling ldap_search_ext() in LdapClient::search(): Can't contact LDAP server",
        })));
        assertTrue(LdapConnectionPool::isConnectionError(cast<hash<ExceptionInfo>>({
            "err": "LDAP-NO-CONTEXT",
            "desc": "cannot execute LdapClient::search(); the LdapClient object has been destroyed or the session context has been unbound",
        })));
        assertFalse(LdapConnectionPool::isConnectionError(cast<hash<ExceptionInfo>>({
            "err": "LDAP-RESULT-ERROR",
            "desc": "no such object",
        })));

        # test discardConnection
        LdapClient conn = pool.get();
        hash<auto> stats = pool.getStats();
        int totalBefore = stats.total;
        pool.discardConnection(conn);
        stats = pool.getStats();
        assertEq(totalBefore - 1, stats.total);

        pool.close();
    }

    #! Test Active Directory GUID/SID decoding
    testAdDecoding() {
        # test objectGUID decoding
        # Known GUID: {6cb4b542-13c7-4e90-b38a-7e89d2a5bf3c}
        # Binary (LE mixed-endian): 42 b5 b4 6c c7 13 90 4e b3 8a 7e 89 d2 a5 bf 3c
        binary guid = <42b5b46cc713904eb38a7e89d2a5bf3c>;
        string guidStr = ActiveDirectoryClient::decodeObjectGUID(guid);
        assertEq("{6cb4b542-13c7-4e90-b38a-7e89d2a5bf3c}", guidStr);

        # test objectGUID wrong size
        assertThrows("LDAP-AD-ERROR", sub() {
            ActiveDirectoryClient::decodeObjectGUID(<0102030405>);
        });

        # test objectSid decoding
        # Known SID: S-1-5-21-3623811015-3361044348-30300820-1013
        # Binary: 01 05 00 00 00 00 00 05 15 00 00 00 A7 65 E0 D7 FC B4 6D C8 04 55 CE 01 F5 03 00 00
        binary sid = <0105000000000005150000009765E0D7FCB46DC80455CE01F5030000>;
        string sidStr = ActiveDirectoryClient::decodeObjectSid(sid);
        assertEq("S-1-5-21-", sidStr.substr(0, 9));
        assertTrue(sidStr =~ /^S-1-5-21-/);

        # test objectSid wrong size
        assertThrows("LDAP-AD-ERROR", sub() {
            ActiveDirectoryClient::decodeObjectSid(<0102>);
        });

        # simple well-known SID: S-1-5-18 (Local System)
        binary localSys = <01010000000000051200000000000000>;
        string localSysStr = ActiveDirectoryClient::decodeObjectSid(localSys);
        assertEq("S-1-5-18", localSysStr);
    }

