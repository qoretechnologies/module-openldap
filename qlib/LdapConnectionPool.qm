%modern

module LdapConnectionPool {
    version = "1.0";
    desc = "LDAP connection pool implementation";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
}

%requires openldap

/** @mainpage LdapConnectionPool Module

    @section ldapconnectionpoolintro Introduction

    This module provides a connection pool implementation for LDAP connections,
    allowing efficient reuse of connections in multi-threaded applications.

    @section ldapconnectionpool_example Example Usage

    @code{.py}
%modern

%requires LdapConnectionPool

# Create a connection pool
LdapConnectionPool pool("ldap://localhost:389", {
    "binddn": "cn=admin,dc=example,dc=com",
    "password": "admin",
    "timeout": 30s,
}, {
    "min_connections": 2,
    "max_connections": 10,
    "idle_timeout": 300s,
});

# Get a connection from the pool
LdapClient ldap = pool.get();

# Use the connection
hash<auto> result = ldap.search({"base": "dc=example,dc=com", "filter": "(objectClass=*)"});

# Return the connection to the pool
pool.release(ldap);

# Or use the callback pattern
pool.withConnection(sub(LdapClient ldap) {
    hash<auto> result = ldap.search({"base": "dc=example,dc=com", "filter": "(objectClass=*)"});
});
    @endcode
*/

#! LDAP connection pool for efficient connection reuse
public class LdapConnectionPool {
    public {
        #! Default minimum number of connections
        const DefaultMinConnections = 1;
        #! Default maximum number of connections
        const DefaultMaxConnections = 10;
        #! Default idle timeout in seconds
        const DefaultIdleTimeout = 300;
        #! Default wait timeout for getting a connection
        const DefaultWaitTimeout = 30;
        #! Default reconnect delay in seconds
        const DefaultReconnectDelay = 2;
        #! Default max reconnect retries (-1 for infinite)
        const DefaultMaxReconnectRetries = 3;
        #! Default health check timeout in seconds
        const DefaultHealthCheckTimeout = 5;
    }

    private {
        #! LDAP URI
        string uri;
        #! Connection options
        hash<auto> opts;
        #! Pool options
        hash<auto> poolOpts;
        #! Enable health checks on connection retrieval
        bool healthCheck = True;
        #! Enable auto-reconnect on failures
        bool reconnect = True;
        #! Reconnect delay
        int reconnectDelay;
        #! Max reconnect retries
        int maxReconnectRetries;

        #! Available connections
        list<hash<auto>> available = ();
        #! In-use connections (tracked by object hash for validation)
        hash<string, bool> activeConnections = {};
        #! In-use connections count
        int inUse = 0;
        #! Total connections created
        int totalCreated = 0;

        #! Mutex for thread safety
        Mutex mutex();
        #! Condition for waiting
        Condition cond();

        #! Shutdown flag
        bool shutdown = False;
    }

    #! Creates a new LDAP connection pool
    /**
        @param uri the LDAP server URI
        @param opts connection options (same as LdapClient constructor)
        @param poolOpts pool configuration options:
        - \c min_connections: minimum number of connections to maintain (default: 1)
        - \c max_connections: maximum number of connections (default: 10)
        - \c idle_timeout: time before idle connections are closed (default: 300s)
        - \c wait_timeout: max time to wait for a connection (default: 30s)
        - \c health_check: if True (default), validate connections with a rootDSE search before returning them
        - \c health_check_timeout: timeout for health check in seconds (default: 5)
        - \c reconnect: if True (default), enable automatic reconnection on failures
        - \c reconnect_delay: delay between reconnect attempts in seconds (default: 2)
        - \c max_reconnect_retries: maximum reconnect attempts; -1 for infinite (default: 3)
    */
    constructor(string uri, *hash<auto> opts, *hash<auto> poolOpts) {
        self.uri = uri;
        self.opts = opts ?? {};
        self.poolOpts = poolOpts ?? {};

        # Set defaults
        if (!self.poolOpts.hasKey("min_connections")) {
            self.poolOpts.min_connections = DefaultMinConnections;
        }
        if (!self.poolOpts.hasKey("max_connections")) {
            self.poolOpts.max_connections = DefaultMaxConnections;
        }
        if (!self.poolOpts.hasKey("idle_timeout")) {
            self.poolOpts.idle_timeout = DefaultIdleTimeout;
        }
        if (!self.poolOpts.hasKey("wait_timeout")) {
            self.poolOpts.wait_timeout = DefaultWaitTimeout;
        }

        # Validate configuration
        if (self.poolOpts.min_connections < 0) {
            throw "LDAP-POOL-ERROR", "min_connections cannot be negative";
        }
        if (self.poolOpts.max_connections < 1) {
            throw "LDAP-POOL-ERROR", "max_connections must be at least 1";
        }
        if (self.poolOpts.min_connections > self.poolOpts.max_connections) {
            throw "LDAP-POOL-ERROR", "min_connections cannot exceed max_connections";
        }

        # Reconnect and health check options
        healthCheck = self.poolOpts.health_check ?? True;
        reconnect = self.poolOpts.reconnect ?? True;
        reconnectDelay = int(self.poolOpts.reconnect_delay ?? DefaultReconnectDelay);
        maxReconnectRetries = int(self.poolOpts.max_reconnect_retries ?? DefaultMaxReconnectRetries);

        # Pre-create minimum connections
        for (int i = 0; i < self.poolOpts.min_connections; i++) {
            createConnection();
        }
    }

    #! Destructor - closes all connections
    destructor() {
        close();
    }

    #! Gets a connection from the pool
    /**
        @param timeout optional timeout override
        @return an LdapClient connection

        @throw LDAP-POOL-TIMEOUT no connection available within timeout
        @throw LDAP-POOL-SHUTDOWN pool has been shut down
    */
    LdapClient get(*timeout timeout) {
        timeout = timeout ?? seconds(poolOpts.wait_timeout);
        date deadline = now_us() + timeout;

        mutex.lock();
        on_exit mutex.unlock();

        while (True) {
            if (shutdown) {
                throw "LDAP-POOL-SHUTDOWN", "connection pool has been shut down";
            }

            # Try to get an available connection
            if (available.size() > 0) {
                hash<auto> connInfo = pop available;
                LdapClient conn = connInfo.connection;

                # Health check if enabled
                if (healthCheck) {
                    int hc_timeout = int(poolOpts.health_check_timeout ?? DefaultHealthCheckTimeout);
                    mutex.unlock();
                    bool healthy;
                    try {
                        conn.search({
                            "base": "",
                            "filter": "(objectClass=*)",
                            "scope": LDAP_SCOPE_BASE,
                            "attributes": "namingContexts",
                        }, seconds(hc_timeout));
                        healthy = True;
                    } catch () {
                        healthy = False;
                    }
                    mutex.lock();

                    if (!healthy) {
                        # connection is stale, discard and try again
                        totalCreated--;
                        continue;
                    }
                }

                inUse++;
                string connId = getConnectionId(conn);
                activeConnections{connId} = True;
                return conn;
            }

            # Try to create a new connection if under limit
            if (totalCreated < poolOpts.max_connections) {
                LdapClient conn = createConnectionLocked();
                inUse++;
                string connId = getConnectionId(conn);
                activeConnections{connId} = True;
                return conn;
            }

            # Wait for a connection to become available
            date remaining = deadline - now_us();
            if (remaining <= 0ms) {
                throw "LDAP-POOL-TIMEOUT", sprintf("timeout waiting for connection (timeout: %y)", timeout);
            }

            cond.wait(mutex, remaining);
        }
    }

    #! Releases a connection back to the pool
    /**
        @param conn the connection to release

        @throw LDAP-POOL-ERROR if the connection was not obtained from this pool
    */
    release(LdapClient conn) {
        mutex.lock();
        on_exit mutex.unlock();

        string connId = getConnectionId(conn);

        # Validate that this connection was obtained from this pool
        if (!activeConnections.hasKey(connId)) {
            throw "LDAP-POOL-ERROR", "cannot release connection: connection was not obtained from this pool or was already released";
        }

        # Remove from active tracking
        remove activeConnections{connId};
        inUse--;

        if (shutdown) {
            # Don't return to pool if shutting down
            return;
        }

        # Return to pool
        available += {
            "connection": conn,
            "last_used": now_us(),
        };

        # Signal waiting threads
        cond.signal();
    }

    #! Executes a callback with a pooled connection
    /**
        @param callback the callback to execute with the connection

        The connection is automatically returned to the pool after the callback
        completes, even if an exception is thrown.
    */
    withConnection(code callback) {
        LdapClient conn = get();
        on_exit release(conn);
        callback(conn);
    }

    #! Executes a callback with a pooled connection and returns the result
    /**
        @param callback the callback to execute with the connection
        @return the return value of the callback

        The connection is automatically returned to the pool after the callback
        completes, even if an exception is thrown.
    */
    auto withConnectionResult(code callback) {
        LdapClient conn = get();
        on_exit release(conn);
        return callback(conn);
    }

    #! Executes a callback with automatic retry on connection errors
    /**
        @param callback the callback to execute with the connection
        @param timeout optional timeout override for connection acquisition
        @return the return value of the callback

        If the callback fails with a connection error and reconnect is enabled,
        the stale connection is discarded and the operation is retried with a new
        connection, up to max_reconnect_retries times.
    */
    auto withConnectionRetry(code callback, *timeout timeout) {
        int attempts = 0;
        while (True) {
            LdapClient conn = get(timeout);
            try {
                auto result = callback(conn);
                release(conn);
                return result;
            } catch (hash<ExceptionInfo> ex) {
                if (reconnect && isConnectionError(ex)
                        && (maxReconnectRetries < 0 || attempts < maxReconnectRetries)) {
                    attempts++;
                    # discard the stale connection instead of releasing it
                    discardConnection(conn);
                    if (reconnectDelay > 0) {
                        # use condition variable for interruptible wait on shutdown
                        mutex.lock();
                        on_exit mutex.unlock();
                        if (!shutdown) {
                            cond.wait(mutex, seconds(reconnectDelay));
                        }
                        if (shutdown) {
                            throw "LDAP-POOL-SHUTDOWN", "connection pool shut down during reconnect wait";
                        }
                    }
                    continue;
                }
                # not a connection error or retries exhausted; release and rethrow
                try {
                    release(conn);
                } catch () {
                    # ignore release errors for already-discarded connections
                }
                rethrow;
            }
        }
    }

    #! Discards a connection without returning it to the pool
    /**
        @param conn the connection to discard

        Use this when a connection is known to be broken. The pool's total
        count is decremented so new connections can be created.
    */
    discardConnection(LdapClient conn) {
        mutex.lock();
        on_exit mutex.unlock();

        string connId = getConnectionId(conn);
        if (activeConnections.hasKey(connId)) {
            remove activeConnections{connId};
            inUse--;
            totalCreated--;
            cond.signal();
        }
    }

    #! Checks if an exception indicates a connection error
    /**
        @param ex the exception info
        @return True if the error indicates a lost or broken connection
    */
    static bool isConnectionError(hash<ExceptionInfo> ex) {
        if (ex.err == "LDAP-ERROR" || ex.err == "LDAP-NO-CONTEXT") {
            string desc = string(ex.desc).lwr();
            return desc =~ /server.*down/
                || desc =~ /can't contact/
                || desc =~ /timeout/
                || desc =~ /connection.*reset/
                || desc =~ /not connected/
                || desc =~ /unbound/;
        }
        return False;
    }

    #! Returns pool statistics
    /**
        @return a hash with pool statistics:
        - \c available: number of available connections
        - \c in_use: number of connections in use
        - \c total: total number of connections
        - \c min: minimum configured connections
        - \c max: maximum configured connections
    */
    hash<auto> getStats() {
        mutex.lock();
        on_exit mutex.unlock();

        return {
            "available": available.size(),
            "in_use": inUse,
            "total": totalCreated,
            "min": poolOpts.min_connections,
            "max": poolOpts.max_connections,
        };
    }

    #! Closes all connections and shuts down the pool
    close() {
        mutex.lock();
        on_exit mutex.unlock();

        shutdown = True;
        available = ();
        activeConnections = {};
        totalCreated = 0;
        inUse = 0;

        # Wake up any waiting threads
        cond.broadcast();
    }

    #! Returns the LDAP URI
    string getUri() {
        return uri;
    }

    #! Removes idle connections that have exceeded the idle timeout
    /**
        Call this periodically to clean up idle connections.
        Returns the number of connections removed.
    */
    int cleanupIdleConnections() {
        mutex.lock();
        on_exit mutex.unlock();

        date cutoff = now_us() - seconds(poolOpts.idle_timeout);
        int removed = 0;

        list<hash<auto>> keep = ();
        for (int i = 0; i < available.size(); i++) {
            hash<auto> connInfo = available[i];
            # Keep if not expired or if we need to maintain minimum
            if (connInfo.last_used > cutoff || (keep.size() + inUse) < poolOpts.min_connections) {
                keep += connInfo;
            } else {
                removed++;
                totalCreated--;
            }
        }
        available = keep;

        return removed;
    }

    private LdapClient createConnection() {
        LdapClient conn(uri, opts);
        mutex.lock();
        on_exit mutex.unlock();

        totalCreated++;
        available += {
            "connection": conn,
            "last_used": now_us(),
        };
        return conn;
    }

    private LdapClient createConnectionLocked() {
        # Note: mutex must already be held
        totalCreated++;
        mutex.unlock();
        on_exit mutex.lock();

        return new LdapClient(uri, opts);
    }

    #! Returns a unique identifier for a connection object
    private string getConnectionId(LdapClient conn) {
        # Use the object's unique ID as the connection identifier
        return sprintf("%s", conn.uniqueHash());
    }
}
